{
  "elasticsearch": {
    "host": "https://es.zippyops.com",
    "index": "lab_monitoring",
    "timeout": 30,
    "max_retries": 3,
    "refresh": "wait_for",
    "user": null,
    "pass": null,
    "api_key": null,
    "ca_certs": null,
    "insecure": false,
    "ssl_assert_hostname": null,
    "ssl_assert_fingerprint": null,
    "cmd_score_index_pattern": "command_scores",
    "cross_server_index_pattern": "lab_monitoring*"
  },
  "monitoring": {
    "interval": 30,
    "max_history_size": 1000,
    "log_level": "INFO",
    "listen_port": 5000,
    "bind_host": "127.0.0.1",
    "enable_remote_exec": true,
    "rate_limit_per_minute": 10,
    "engagement_session_timeout": 30,
    "engagement_data_retention": 30,
    "server_id": "lab_server_01",
    "comparison_servers": [],
    "comparison_interval": 300,
    "inactivity_threshold": 1,
    "failed_attempts_threshold": 5,
    "struggle_detection_window": 30,
    "risk_assessment_interval": 300,
    "api_key": "0a1b4c070e460921be366e73feacedab861e13b98d8e9457eab64a48c35bef6e",
    "allowed_commands": [
      "ps",
      "top",
      "htop",
      "df",
      "du",
      "free",
      "uptime",
      "who",
      "w",
      "netstat",
      "ss",
      "lsof",
      "iostat",
      "vmstat",
      "sar",
      "dmesg",
      "journalctl",
      "systemctl",
      "service",
      "status"
    ]
  },
  "advanced_monitoring": {
    "filesystem_tracking": {
      "enabled": true,
      "watch_directories": ["/home", "/workspace", "/projects"],
      "track_git_operations": true,
      "scan_interval_seconds": 300
    },
    "error_debugging": {
      "enabled": true,
      "track_compilation_errors": true,
      "track_runtime_errors": true,
      "track_test_failures": true,
      "auto_mark_resolved": true
    },
    "development_environment": {
      "enabled": true,
      "detect_ides": true,
      "track_plugins": true,
      "monitor_environments": true
    },
    "browser_activity": {
      "enabled": true,
      "classify_educational": true,
      "track_video_tutorials": true,
      "educational_threshold_minutes": 10
    },
    "code_quality": {
      "enabled": true,
      "analyze_on_save": false,
      "track_test_coverage": true,
      "quality_score_threshold": 70
    },
    "package_dependency": {
      "enabled": true,
      "track_installations": true,
      "detect_conflicts": true,
      "monitor_virtualenvs": true
    },
    "collaboration": {
      "enabled": true,
      "detect_pair_programming": true,
      "track_code_reviews": true,
      "monitor_help_requests": true
    },
    "learning_path": {
      "enabled": true,
      "track_exercises": true,
      "track_assignments": true,
      "track_quizzes": true,
      "milestone_tracking": true
    },
    "resource_access": {
      "enabled": true,
      "track_databases": true,
      "track_apis": true,
      "track_cloud_services": true,
      "track_remote_connections": true
    },
    "time_distribution": {
      "enabled": true,
      "track_activity_blocks": true,
      "detect_context_switches": true,
      "analyze_productivity_patterns": true
    },
    "hardware_utilization": {
      "enabled": true,
      "track_gpu_usage": true,
      "track_peripherals": true,
      "detect_monitors": true
    },
    "network_behavior": {
      "enabled": true,
      "track_transfers": true,
      "track_repository_access": true,
      "bandwidth_threshold_mbps": 100
    },
    "terminal_console": {
      "enabled": true,
      "analyze_bash_history": true,
      "track_sessions": true,
      "proficiency_analysis": true
    },
    "project_lifecycle": {
      "enabled": true,
      "track_builds": true,
      "track_deployments": true,
      "track_version_tags": true,
      "track_milestones": true
    }
  },
  "inactivity_alert": {
    "enabled": false,
    "webhook_url": null,
    "webhook_auth": null,
    "inactivity_window_minutes": 60,
    "http_method": "POST",
    "max_retries": 3,
    "retry_delay_seconds": 5,
    "check_command_activity": true,
    "check_network_activity": true,
    "network_traffic_bytes_threshold": 1024
  },
  "users": {
    "ignore_users": [
      "system",
      "root",
      "Administrator",
      "SYSTEM"
    ]
  },
  "ai": {
    "anomaly_detection": {
      "contamination": 0.1,
      "min_samples": 10
    },
    "forecasting": {
      "periods": 5,
      "min_samples": 10
    }
  },
  "dangerous_commands": [
