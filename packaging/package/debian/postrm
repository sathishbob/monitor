#!/bin/bash
# postrm script for monitor-agent Debian package

set -e

# Remove user if it exists and is not in use
if id monitor >/dev/null 2>&1; then
    # Check if user is logged in or has processes
    if ! who | grep -q monitor && ! pgrep -u monitor >/dev/null 2>&1; then
        userdel monitor >/dev/null 2>&1 || true
    fi
fi

# Clean up logs (optional - can be commented out to keep logs)
# rm -rf /var/log/monitor-agent

systemctl daemon-reload

